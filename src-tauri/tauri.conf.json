{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alva",
  "version": "../package.json",
  "identifier": "io.github.hiyroscript.alva",
  "build": {
    "frontendDist": "../dist/itch",
    "beforeDevCommand": "npm run build:itch",
    "beforeBuildCommand": "npm run build:itch"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Alva",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#050506"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://alva-online.pages.dev wss://alva-online.pages.dev",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb"],
    "publisher": "hiyroscript",
    "homepage": "https://github.com/hiyroscript/alva",
    "category": "ActionGame",
    "shortDescription": "A 2D sprite platform fighting game.",
    "longDescription": "Alva is a 2D sprite platform fighting game: fighters battle on compact stages over a Void, and every fall into it is a point for the opponent.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
